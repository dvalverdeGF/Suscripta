# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

###> suscripta/api ###
# Un origen fijo para poder probar el preflight de verdad: el test de CORS
# afirma que este origen recibe 204 y que cualquier otro no recibe nada.
#
# Las comillas simples de fuera son obligatorias (Dotenv se come las dobles).
API_CORS_ALLOWED_ORIGINS='["https://integrador.test"]'
###< suscripta/api ###

###> suscripta/webhooks ###
# El test funcional del panel envía una entrega real a un puerto cerrado de
# `host.docker.internal`, que resuelve a una IP privada del Docker. Sin esta
# excepción la guarda anti-SSRF la rechazaría antes de intentar conectar.
WEBHOOK_ALLOWED_PRIVATE_HOSTS=host.docker.internal
###< suscripta/webhooks ###
