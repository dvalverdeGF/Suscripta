{% extends 'backoffice/base.html.twig' %}

{% block title %}Registrar factura — Suscripta{% endblock %}

{% block content %}
    <div class="bo-page-header">
        <div class="bo-page-header__heading">
            <p class="bo-page-header__back">
                <a href="{{ path('app_invoices_index') }}">← Facturas</a>
            </p>
            <h1 class="bo-page-header__title">Registrar factura</h1>
            <p class="bo-page-header__subtitle">
                Un cobro que ya se ha producido. Si además tienes el fichero, súbelo como documento.
            </p>
        </div>
    </div>

    {#
    El formulario lleva `id` porque el boton de guardar vive en la barra de
    acciones del pie y se le asocia con el atributo HTML `form`.
#}
{{ form_start(form, {attr: {id: 'invoice-form', class: 'form'}}) }}
        {{ form_errors(form) }}

        <div class="card mb-4">
            <div class="card-header">
                <h2 class="card-title">Qué se ha cobrado</h2>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    {{ form_row(form.issuedAt) }}
                    {{ form_row(form.number) }}
                    {{ form_row(form.total) }}
                    {{ form_row(form.currency) }}
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header">
                <h2 class="card-title">A qué corresponde</h2>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    {{ form_row(form.serviceId) }}
                    {{ form_row(form.providerId) }}
                    {{ form_row(form.periodStart) }}
                    {{ form_row(form.periodEnd) }}
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header">
                <h2 class="card-title">Estado</h2>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    {{ form_row(form.status) }}
                    {{ form_row(form.paidAt) }}
                    {{ form_row(form.source) }}
                </div>
            </div>
        </div>

    {{ form_end(form) }}
{% endblock %}

{% block page_actions %}
    {{ include('backoffice/_form_actions.html.twig', {
        form_id: 'invoice-form',
        submit_label: 'Registrar factura',
        submit_icon: 'fa-receipt',
        back_path: path('app_invoices_index'),
    }) }}
{% endblock %}
