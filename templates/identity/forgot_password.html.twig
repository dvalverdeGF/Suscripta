{% extends 'layout/auth.html.twig' %}

{% block title %}Recuperar contraseña — Suscripta{% endblock %}

{% block heading %}Recuperar contraseña{% endblock %}

{% block subtitle %}
    <p class="bo-login__subtitle">
        Indica tu correo y te enviaremos un enlace para elegir una contraseña nueva.
    </p>
{% endblock %}

{% block content %}
    {{ form_start(form, { attr: { novalidate: 'novalidate' } }) }}
        {{ form_errors(form) }}
        {{ form_row(form.email) }}

        <button type="submit" class="btn btn-primary w-100">Enviar enlace</button>
    {{ form_end(form) }}

    <p class="text-center small mt-4 mb-0">
        <a href="{{ path('app_login') }}">Volver a entrar</a>
    </p>
{% endblock %}
