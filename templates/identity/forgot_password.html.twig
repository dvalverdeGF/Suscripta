{% extends 'base.html.twig' %}

{% block title %}Recuperar contraseña — Suscripta{% endblock %}

{% block body %}
    <main class="auth-layout">
        <div class="auth-card card">
            <div class="card__body">
                <h1 class="auth-card__title">Recuperar contraseña</h1>
                <p class="text-muted mb-6">
                    Indica tu correo y te enviaremos un enlace para elegir una contraseña nueva.
                </p>

                {% include 'layout/_flashes.html.twig' %}

                {{ form_start(form, { attr: { class: 'form', novalidate: 'novalidate' } }) }}
                    {{ form_errors(form) }}
                    {{ form_row(form.email) }}

                    <button type="submit" class="btn btn--primary btn--block">Enviar enlace</button>
                {{ form_end(form) }}

                <p class="text-center text-sm mt-6 mb-0">
                    <a href="{{ path('app_login') }}">Volver a entrar</a>
                </p>
            </div>
        </div>
    </main>
{% endblock %}
