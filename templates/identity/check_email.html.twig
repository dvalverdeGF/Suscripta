{% extends 'layout/auth.html.twig' %}

{% block title %}Revisa tu correo — Suscripta{% endblock %}

{% block heading %}Revisa tu correo{% endblock %}

{% block content %}
    <p class="text-secondary mb-3">
        Si existe una cuenta con esa dirección, te hemos enviado un enlace para
        restablecer la contraseña. Caduca en una hora y solo puede usarse una vez.
    </p>
    <p class="text-secondary mb-4">
        ¿No lo encuentras? Mira en la carpeta de spam o
        <a href="{{ path('app_forgot_password') }}">pide otro enlace</a>.
    </p>

    <a class="btn btn-outline-secondary w-100" href="{{ path('app_login') }}">Volver a entrar</a>
{% endblock %}
