{% extends 'base.html.twig' %}

{% block title %}Nueva contraseña — Suscripta{% endblock %}

{% block body %}
    <main class="auth-layout">
        <div class="auth-card card">
            <div class="card__body">
                <h1 class="auth-card__title">Elige una contraseña nueva</h1>
                <p class="text-muted mb-6">
                    Al guardarla, el enlace dejará de funcionar y se cerrarán las sesiones
                    abiertas con la contraseña anterior.
                </p>

                {% include 'layout/_flashes.html.twig' %}

                {{ form_start(form, { attr: { class: 'form', novalidate: 'novalidate' } }) }}
                    {{ form_errors(form) }}
                    {{ form_row(form.plainPassword.first) }}
                    {{ form_row(form.plainPassword.second) }}

                    <button type="submit" class="btn btn--primary btn--block">Guardar contraseña</button>
                {{ form_end(form) }}
            </div>
        </div>
    </main>
{% endblock %}
