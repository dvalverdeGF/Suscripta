{% extends 'layout/auth.html.twig' %}

{% block title %}Nueva contraseña — Suscripta{% endblock %}

{% block heading %}Elige una contraseña nueva{% endblock %}

{% block subtitle %}
    <p class="bo-login__subtitle">
        Al guardarla, el enlace dejará de funcionar y se cerrarán las sesiones
        abiertas con la contraseña anterior.
    </p>
{% endblock %}

{% block content %}
    {{ form_start(form, { attr: { novalidate: 'novalidate' } }) }}
        {{ form_errors(form) }}
        {{ form_row(form.plainPassword.first) }}
        {{ form_row(form.plainPassword.second) }}

        <button type="submit" class="btn btn-primary w-100">Guardar contraseña</button>
    {{ form_end(form) }}
{% endblock %}
