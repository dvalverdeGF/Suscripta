{% extends 'layout/auth.html.twig' %}

{% block title %}Crear cuenta — Suscripta{% endblock %}

{% block heading %}Crear cuenta{% endblock %}

{% block subtitle %}
    <p class="bo-login__subtitle">
        Conecta tu correo de facturación y descubre automáticamente lo que estás pagando.
    </p>
{% endblock %}

{% block content %}
    {{ form_start(form, { attr: { novalidate: 'novalidate' } }) }}
        {{ form_errors(form) }}
        {{ form_row(form.displayName) }}
        {{ form_row(form.email) }}
        {{ form_row(form.plainPassword.first) }}
        {{ form_row(form.plainPassword.second) }}
        {{ form_row(form.acceptTerms) }}

        <button type="submit" class="btn btn-primary w-100">Crear cuenta</button>
    {{ form_end(form) }}

    <p class="text-center small mt-4 mb-0">
        ¿Ya tienes cuenta? <a href="{{ path('app_login') }}">Entrar</a>
    </p>
{% endblock %}
