{% extends 'layout/auth.html.twig' %}

{% block title %}Entrar — Suscripta{% endblock %}

{% block heading %}Entrar en Suscripta{% endblock %}

{% block subtitle %}<p class="bo-login__subtitle">Descubre y controla tus servicios recurrentes.</p>{% endblock %}

{% block content %}
    {% if error %}
        <div class="alert alert-danger" role="alert">
            <i class="fa-solid fa-circle-exclamation me-2"></i>{{ error.messageKey|trans(error.messageData, 'security') }}
        </div>
    {% endif %}

    {% set demo = demo_account() %}
    {% if demo %}
        <div class="alert alert-info d-flex align-items-center justify-content-between gap-2" role="status">
            <div>
                <strong class="d-block">{{ demo.label }}</strong>
                <span class="small"><code>{{ demo.email }}</code> / <code>{{ demo.password }}</code></span>
            </div>
            <button type="button" class="btn btn-sm btn-outline-primary" id="bo-demo-fill">
                Rellenar
            </button>
        </div>
    {% endif %}

    <form method="post" novalidate>
        <div class="mb-3">
            <label class="form-label" for="email">Correo electrónico</label>
            <input class="form-control" type="email" id="email" name="email"
                   value="{{ last_username }}" required autofocus
                   autocomplete="email" inputmode="email">
        </div>

        <div class="mb-3">
            <label class="form-label" for="password">Contraseña</label>
            <input class="form-control" type="password" id="password" name="password"
                   required autocomplete="current-password">
        </div>

        <div class="form-check mb-3">
            <input class="form-check-input" type="checkbox" id="remember_me" name="_remember_me" value="on">
            <label class="form-check-label" for="remember_me">Mantener la sesión iniciada</label>
        </div>

        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        <button type="submit" class="btn btn-primary w-100">Entrar</button>
    </form>

    <p class="text-center small mt-4 mb-0">
        ¿Todavía no tienes cuenta?
        <a href="{{ path('app_register') }}">Crear una cuenta</a>
    </p>

    {% if demo %}
        <script nonce="{{ csp_nonce() }}">
            (function () {
                var button = document.getElementById('bo-demo-fill');
                if (!button) {
                    return;
                }

                button.addEventListener('click', function () {
                    var email = document.getElementById('email');
                    var password = document.getElementById('password');

                    if (email) {
                        email.value = '{{ demo.email|e('js') }}';
                    }

                    if (password) {
                        password.value = '{{ demo.password|e('js') }}';
                    }

                    if (email) {
                        email.focus();
                    }
                });
            })();
        </script>
    {% endif %}
{% endblock %}
