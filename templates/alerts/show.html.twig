{% extends 'backoffice/base.html.twig' %}

{% block title %}{{ alert.title }} — Suscripta{% endblock %}

{% block content %}
    <div class="bo-page-header">
        <div class="bo-page-header__heading">
            <p class="bo-page-header__back">
                <a href="{{ path('app_alerts_index') }}">← Avisos</a>
            </p>
            <h1 class="bo-page-header__title">{{ alert.title }}</h1>
            <p class="bo-page-header__subtitle">{{ alert.type.description() }}</p>
        </div>
    </div>

    <div class="row g-3">
        <div class="card">
            <div class="card-header">
                <h2 class="card-title">Qué ha pasado</h2>
            </div>
            <div class="card-body">
                <p>{{ alert.message }}</p>

                <dl class="bo-definition-list">
                    <dt>Tipo</dt>
                    <dd>{{ alert.type.label() }}</dd>

                    <dt>Gravedad</dt>
                    <dd>
                        <span class="badge text-bg-{{ alert.severity.value == 'critical' ? 'danger' : (alert.severity.value == 'warning' ? 'warning' : 'info') }}">
                            {{ alert.severity.label() }}
                        </span>
                    </dd>

                    <dt>Estado</dt>
                    <dd>{{ alert.status.label() }}</dd>

                    {% if alert.dueAt %}
                        <dt>Fecha</dt>
                        <dd><time datetime="{{ alert.dueAt|date('c') }}">{{ alert.dueAt|date('d/m/Y') }}</time></dd>
                    {% endif %}

                    <dt>Detectado</dt>
                    <dd><time datetime="{{ alert.createdAt|date('c') }}">{{ alert.createdAt|date('d/m/Y H:i') }}</time></dd>

                    {% if alert.resolvedAt %}
                        <dt>Resuelto</dt>
                        <dd><time datetime="{{ alert.resolvedAt|date('c') }}">{{ alert.resolvedAt|date('d/m/Y H:i') }}</time></dd>
                    {% endif %}
                </dl>

                {% if alert.status.value == 'open' %}
                    <div class="d-flex flex-wrap align-items-center justify-content-end gap-2 mt-3">
                        <form method="post" action="{{ path('app_alerts_dismiss', {id: alert.id.toRfc4122()}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('alert_dismiss_' ~ alert.id.toRfc4122()) }}">
                            <button type="submit" class="btn btn-outline-secondary">Descartar</button>
                        </form>
                        <form method="post" action="{{ path('app_alerts_acknowledge', {id: alert.id.toRfc4122()}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('alert_acknowledge_' ~ alert.id.toRfc4122()) }}">
                            <button type="submit" class="btn btn-primary">Marcar como visto</button>
                        </form>
                    </div>
                {% endif %}
            </div>
        </div>

        <div class="d-flex flex-column gap-3">
            {% if alert.discoveryId %}
                <div class="card">
                    <div class="card-header">
                        <h2 class="card-title">Propuesta</h2>
                    </div>
                    <div class="card-body">
                        <p class="mb-0">
                            <a href="{{ path('app_discoveries_show', {id: alert.discoveryId.toRfc4122()}) }}">
                                Ver la propuesta en la bandeja de descubrimientos
                            </a>
                        </p>
                    </div>
                </div>
            {% endif %}

            {% if service %}
                <div class="card">
                    <div class="card-header">
                        <h2 class="card-title">Servicio</h2>
                    </div>
                    <div class="card-body">
                        <p>
                            <a href="{{ path('app_services_show', {id: service.id.toRfc4122()}) }}">{{ service.name }}</a>
                        </p>
                        <dl class="bo-definition-list">
                            <dt>Estado</dt>
                            <dd>{{ service.status.label() }}</dd>
                            <dt>Periodicidad</dt>
                            <dd>{{ service.billingPeriod.label() }}</dd>
                            {% if service.nextChargeAt %}
                                <dt>Próximo cobro</dt>
                                <dd><time datetime="{{ service.nextChargeAt|date('c') }}">{{ service.nextChargeAt|date('d/m/Y') }}</time></dd>
                            {% endif %}
                            {% if service.renewalAt %}
                                <dt>Renovación</dt>
                                <dd><time datetime="{{ service.renewalAt|date('c') }}">{{ service.renewalAt|date('d/m/Y') }}</time></dd>
                            {% endif %}
                        </dl>
                    </div>
                </div>
            {% endif %}

            <div class="card">
                <div class="card-header">
                    <h2 class="card-title">Entregas</h2>
                </div>
                <div class="card-body">
                    {% if notifications is empty %}
                        <p class="text-muted">Todavía no se ha entregado este aviso por ningún canal.</p>
                    {% else %}
                        <ul class="d-flex flex-column gap-2">
                            {% for notification in notifications %}
                                <li>
                                    <span class="badge text-bg-{{ notification.status.value == 'sent' ? 'success' : (notification.status.value == 'failed' ? 'danger' : 'info') }}">
                                        {{ notification.status.label() }}
                                    </span>
                                    {{ notification.channel.label() }}
                                    {% if notification.sentAt %}
                                        <span class="text-muted small">· {{ notification.sentAt|date('d/m/Y H:i') }}</span>
                                    {% endif %}
                                    {% if notification.error %}
                                        <span class="text-muted small">· {{ notification.error }}</span>
                                    {% endif %}
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
