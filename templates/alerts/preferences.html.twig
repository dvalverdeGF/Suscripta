{% extends 'backoffice/base.html.twig' %}

{% block title %}Preferencias de avisos — Suscripta{% endblock %}

{% block content %}
    <div class="bo-page-header">
        <div class="bo-page-header__heading">
            <p class="bo-page-header__back">
                <a href="{{ path('app_alerts_index') }}">← Avisos</a>
            </p>
            <h1 class="bo-page-header__title">Preferencias de avisos</h1>
            <p class="bo-page-header__subtitle">
                Elige qué quieres ver en la aplicación y qué quieres recibir por correo.
            </p>
        </div>
    </div>

    <div class="alert alert-info mb-4">
        <p>
            Los avisos <strong>críticos</strong> —un cobro inminente o una renovación a punto de
            cerrarse— se envían siempre por correo, aunque desactives el canal. Es justo el caso
            en el que un aviso silenciado no sirve de nada.
        </p>
    </div>

    {#
    El formulario lleva `id` porque el boton de guardar vive en la barra de
    acciones del pie y se le asocia con el atributo HTML `form`.
#}
{{ form_start(form, {attr: {id: 'alert-preferences-form'}}) }}
        <div class="table-responsive">
            <table class="table bo-table bo-table--stack align-middle">
                <caption class="visually-hidden">Preferencias de avisos por tipo y canal</caption>
                <thead>
                    <tr>
                        <th scope="col">Tipo de aviso</th>
                        {% for channel in channels %}
                            <th scope="col">{{ channel.label() }}</th>
                        {% endfor %}
                    </tr>
                </thead>
                <tbody>
                    {% for type in types %}
                        <tr>
                            <th scope="row" data-label="Tipo de aviso">
                                {{ type.label() }}
                                <span class="text-muted small">{{ type.description() }}</span>
                            </th>
                            {% for channel in channels %}
                                {% set field = attribute(form, type.value ~ '_' ~ channel.value) %}
                                <td data-label="{{ channel.label() }}">
                                    <label class="form-check">
                                        {{ form_widget(field) }}
                                        <span>{{ channel.label() }}</span>
                                    </label>
                                </td>
                            {% endfor %}
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

    {{ form_end(form) }}
{% endblock %}

{% block page_actions %}
    {{ include('backoffice/_form_actions.html.twig', {
        form_id: 'alert-preferences-form',
        submit_label: 'Guardar preferencias',
        back_path: path('app_alerts_index'),
    }) }}
{% endblock %}
