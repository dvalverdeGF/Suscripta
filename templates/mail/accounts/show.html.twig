{% extends 'backoffice/base.html.twig' %}

{% block title %}{{ account.displayName|default(account.emailAddress) }} — Suscripta{% endblock %}

{% block content %}
    <div class="bo-page-header">
        <div class="bo-page-header__heading">
            <h1 class="bo-page-header__title">{{ account.displayName|default(account.emailAddress) }}</h1>
            <p class="bo-page-header__subtitle">{{ account.emailAddress }}</p>
        </div>
        <div class="bo-page-header__actions">
            {% if account.isConfigured %}
                <form method="post" action="{{ path('app_mail_accounts_sync', {id: account.id.toRfc4122()}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('mail_account_sync_' ~ account.id.toRfc4122()) }}">
                    <button type="submit" class="btn btn-primary btn-sm">Sincronizar ahora</button>
                </form>
            {% endif %}
            <a class="btn btn-outline-secondary btn-sm" href="{{ path('app_mail_accounts_edit', {id: account.id.toRfc4122()}) }}">Editar</a>
        </div>
    </div>

    {% if account.status.value == 'error' and account.lastSyncError %}
        <div class="alert alert-danger mb-4" role="alert">
            <strong>No hemos podido leer este buzón.</strong>
            <p>{{ account.lastSyncError }}</p>
        </div>
    {% endif %}

    <div class="bo-metrics mb-4">
        <div class="bo-metric">
            <span class="bo-metric__label">Estado</span>
            <span class="bo-metric__value">
                <span class="badge text-bg-{{ account.status.value == 'active' ? 'success' : (account.status.value == 'error' ? 'danger' : 'warning') }}">
                    {{ account.status.label() }}
                </span>
            </span>
        </div>
        <div class="bo-metric">
            <span class="bo-metric__label">Mensajes indexados</span>
            <span class="bo-metric__value">{{ messageCount }}</span>
            <span class="bo-metric__hint">Solo se guardan metadatos, nunca el cuerpo del correo.</span>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header">
            <h2 class="card-title">Configuración</h2>
        </div>
        <div class="card-body">
            <dl class="bo-definition-list">
                <dt>Servidor</dt>
                <dd>{{ account.imapHost }}:{{ account.imapPort }}</dd>
                <dt>Cifrado</dt>
                <dd>{{ account.imapEncryption ? account.imapEncryption.label() : '—' }}</dd>
                <dt>Usuario</dt>
                <dd>{{ account.imapUsername }}</dd>
                <dt>Carpeta</dt>
                <dd>{{ account.imapFolder }}</dd>
                <dt>Contraseña</dt>
                <dd>{{ account.credentialsEncrypted ? 'Guardada y cifrada' : 'No guardada' }}</dd>
                <dt>Última lectura</dt>
                <dd>
                    {% if account.lastSyncAt %}
                        <time datetime="{{ account.lastSyncAt|date('c') }}">{{ account.lastSyncAt|date('d/m/Y H:i') }}</time>
                    {% else %}
                        Todavía no se ha leído
                    {% endif %}
                </dd>
            </dl>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header">
            <h2 class="card-title">Acciones</h2>
        </div>
        <div class="card-body">
            <div class="d-flex flex-wrap align-items-center gap-2">
                <form method="post" action="{{ path('app_mail_accounts_test', {id: account.id.toRfc4122()}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('mail_account_test_' ~ account.id.toRfc4122()) }}">
                    <button type="submit" class="btn btn-outline-secondary">Probar conexión</button>
                </form>

                {% if account.status.value != 'disabled' %}
                    <form method="post" action="{{ path('app_mail_accounts_disconnect', {id: account.id.toRfc4122()}) }}"
                          data-controller="confirm"
                          data-confirm-message-value="Dejaremos de leer este buzón. Tus servicios y su historial no se tocan.">
                        <input type="hidden" name="_token" value="{{ csrf_token('mail_account_disconnect_' ~ account.id.toRfc4122()) }}">
                        <button type="submit" class="btn btn-outline-secondary">Desconectar</button>
                    </form>
                {% endif %}
            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header">
            <h2 class="card-title">Reenviar facturas sin dar acceso al buzón</h2>
        </div>
        <div class="card-body">
            {% if account.isForwardingEnabled %}
                <p class="text-muted">
                    Reenvía tus facturas a esta dirección y las leeremos igual que si
                    tuviéramos acceso al buzón. No necesitamos tu contraseña.
                </p>
                <div class="mb-3">
                    <span class="form-label">Tu dirección de ingesta</span>
                    <p class="text-end"><code>{{ account.forwardingAddress }}</code></p>
                    <p class="form-text">
                        Trátala como una contraseña: quien la conozca podría intentar
                        enviarte facturas falsas. Si se filtra, cámbiala.
                    </p>
                </div>
            {% else %}
                <p class="text-muted">
                    Si prefieres no darnos acceso a tu correo, activa el reenvío: te
                    damos una dirección dedicada y tú reenvías ahí tus facturas.
                    No hace falta contraseña ni autorizar ninguna aplicación.
                </p>
            {% endif %}

            {{ form_start(forwardingForm, {action: path('app_mail_accounts_forwarding', {id: account.id.toRfc4122()})}) }}
                {{ form_row(forwardingForm.senders) }}
                <div class="d-flex flex-wrap gap-2 mt-3">
                    <button type="submit" class="btn btn-primary">
                        {{ account.isForwardingEnabled ? 'Guardar remitentes' : 'Activar reenvío' }}
                    </button>
                </div>
            {{ form_end(forwardingForm) }}

            {% if account.isForwardingEnabled %}
                <div class="d-flex flex-wrap align-items-center gap-2 mt-3">
                    <form method="post" action="{{ path('app_mail_accounts_forwarding_rotate', {id: account.id.toRfc4122()}) }}"
                          data-controller="confirm"
                          data-confirm-message-value="La dirección actual dejará de aceptar correo. Tendrás que actualizarla en tu proveedor.">
                        <input type="hidden" name="_token" value="{{ csrf_token('mail_account_forwarding_rotate_' ~ account.id.toRfc4122()) }}">
                        <button type="submit" class="btn btn-outline-secondary btn-sm">Cambiar la dirección</button>
                    </form>
                    <form method="post" action="{{ path('app_mail_accounts_forwarding_disable', {id: account.id.toRfc4122()}) }}"
                          data-controller="confirm"
                          data-confirm-message-value="La dirección dejará de aceptar correo. Podrás volver a activarla.">
                        <input type="hidden" name="_token" value="{{ csrf_token('mail_account_forwarding_disable_' ~ account.id.toRfc4122()) }}">
                        <button type="submit" class="btn btn-outline-secondary btn-sm">Desactivar reenvío</button>
                    </form>
                </div>
            {% endif %}
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header">
            <h2 class="card-title">Últimas lecturas</h2>
        </div>
        <div class="card-body{% if runs is not empty %} p-0{% endif %}">
            {% if runs is empty %}
                <p class="text-muted">Todavía no hemos leído este buzón.</p>
            {% else %}
                <div class="table-responsive">
                    <table class="table bo-table bo-table--stack align-middle">
                        <thead>
                            <tr>
                                <th scope="col">Cuándo</th>
                                <th scope="col">Resultado</th>
                                <th scope="col" class="text-end">Revisados</th>
                                <th scope="col" class="text-end">Nuevos</th>
                                <th scope="col" class="text-end">Descubrimientos</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for run in runs %}
                                <tr>
                                    <td data-label="Cuándo">
                                        <time datetime="{{ run.startedAt|date('c') }}">{{ run.startedAt|date('d/m/Y H:i') }}</time>
                                    </td>
                                    <td data-label="Resultado">
                                        <span class="badge text-bg-{{ run.status.value == 'completed' ? 'success' : (run.status.value == 'failed' ? 'danger' : 'info') }}">
                                            {{ run.status.label() }}
                                        </span>
                                        {% if run.error %}
                                            <p class="small text-muted">{{ run.error }}</p>
                                        {% endif %}
                                    </td>
                                    <td data-label="Revisados" class="text-end">{{ run.messagesSeen }}</td>
                                    <td data-label="Nuevos" class="text-end">{{ run.messagesProcessed }}</td>
                                    <td data-label="Descubrimientos" class="text-end">{{ run.discoveriesCreated }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h2 class="card-title">Eliminar el buzón</h2>
        </div>
        <div class="card-body">
            <p class="text-muted">
                Se borran las credenciales y todos los mensajes indexados de este buzón.
                Los servicios que ya hayas confirmado se conservan, porque son datos tuyos.
            </p>
            <form method="post" action="{{ path('app_mail_accounts_delete', {id: account.id.toRfc4122()}) }}"
                  data-controller="confirm"
                  data-confirm-message-value="Se eliminará el buzón y todo lo leído de él. Esta acción no se puede deshacer.">
                <input type="hidden" name="_token" value="{{ csrf_token('mail_account_delete_' ~ account.id.toRfc4122()) }}">
                <button type="submit" class="btn btn-danger">Eliminar buzón y sus datos</button>
            </form>
        </div>
    </div>
{% endblock %}
