{% extends 'backoffice/base.html.twig' %}

{% block title %}Conectar buzón — Suscripta{% endblock %}

{% block content %}
    <div class="bo-page-header">
        <div class="bo-page-header__heading">
            <h1 class="bo-page-header__title">Conectar un buzón</h1>
            <p class="bo-page-header__subtitle">
                Funciona con cualquier servidor IMAP: Gmail, Microsoft 365, el correo de tu hosting
                o el de tu empresa. Comprobamos la conexión antes de guardar nada.
            </p>
        </div>
    </div>

    {% include 'mail/accounts/_form.html.twig' with {
        form: form,
        form_id: 'mail-account-form',
    } only %}
{% endblock %}

{% block page_actions %}
    {{ include('backoffice/_form_actions.html.twig', {
        form_id: 'mail-account-form',
        submit_label: 'Conectar buzón',
        submit_icon: 'fa-plug',
        back_path: path('app_mail_accounts_index'),
    }) }}
{% endblock %}
