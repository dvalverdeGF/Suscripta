{#
    Formulario de conexión de un buzón.

    El formulario lleva `id` porque el botón de guardar vive en la barra de
    acciones del pie y se le asocia con el atributo HTML `form`.

    Qué campos aparecen depende del proveedor y lo decide el servidor, no el
    JavaScript: con un proveedor de catálogo (Gmail, Microsoft, Yahoo, iCloud)
    el servidor, el puerto y el cifrado vienen dados y los campos ni siquiera
    existen. Los bloques `manual` siguen marcados porque en la edición de un
    buzón ya conectado el proveedor sí es un desplegable, y ahí el controlador
    de Stimulus los esconde al cambiar a un proveedor de catálogo.

    Parámetros:
      form              la vista del formulario (obligatorio).
      form_id           id del formulario al que apunta el botón de guardar.
      app_password_url  página oficial donde se genera la contraseña de
                        aplicación; `null` si el proveedor no la tiene.
#}
{% set app_password_url = app_password_url|default(null) %}

{{ form_start(form, {attr: {id: form_id|default('mail-account-form'), class: 'form', 'data-controller': 'mail-provider'}}) }}
    {{ form_errors(form) }}

    <div class="card mb-4">
        <div class="card-header">
            <h2 class="card-title">Tu cuenta</h2>
        </div>
        <div class="card-body">
            <div class="row g-3">
                {% if form.provider is defined %}
                    {{ form_row(form.provider) }}
                {% endif %}
                {{ form_row(form.emailAddress) }}
                {{ form_row(form.displayName) }}
                {{ form_row(form.imapUsername) }}
            </div>
        </div>
    </div>

    {% if form.imapHost is defined %}
        <div class="card mb-4">
            <div class="card-header">
                <h2 class="card-title">Servidor</h2>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-12" data-mail-provider-target="manual">
                        {{ form_row(form.imapHost) }}
                        {{ form_widget(form.discover) }}
                    </div>
                    <div class="col-12" data-mail-provider-target="manual">
                        <div class="row g-3">
                            {{ form_row(form.imapPort) }}
                            {{ form_row(form.imapEncryption) }}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}

    <div class="card mb-4">
        <div class="card-header">
            <h2 class="card-title">Acceso y carpeta</h2>
        </div>
        <div class="card-body">
            <div class="row g-3">
                {{ form_row(form.password) }}
                {{ form_row(form.imapFolder) }}
            </div>

            {#
                El enlace se genera aquí cuando el proveedor es fijo y lo
                actualiza el controlador de Stimulus cuando se elige otro en el
                desplegable. El objetivo está en el `<a>`, no en el párrafo: es
                el ancla la que tiene `href`.
            #}
            <p class="form-text" data-mail-provider-target="appPasswordNote"{% if app_password_url is null %} hidden{% endif %}>
                Este proveedor no acepta la contraseña de tu cuenta: hay que generar una
                <a href="{{ app_password_url|default('#') }}"
                   target="_blank"
                   rel="noopener noreferrer"
                   data-mail-provider-target="appPasswordLink">contraseña de aplicación</a>
                y pegarla aquí.
            </p>

            <p class="form-text">
                La contraseña se guarda cifrada y solo se usa para leer. Nunca escribimos,
                movemos ni borramos nada de tu buzón.
            </p>
        </div>
    </div>
{{ form_end(form) }}
