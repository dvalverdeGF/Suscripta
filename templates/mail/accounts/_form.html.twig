{#
    El formulario lleva `id` porque el boton de guardar vive en la barra de
    acciones del pie y se le asocia con el atributo HTML `form`.

    Los campos de servidor van dentro de bloques marcados como `manual`: con un
    proveedor de catalogo (Gmail, Microsoft, Yahoo, iCloud) el servidor lo pone
    la aplicacion y ensenarlos solo invita a escribir algo que se va a ignorar.
#}
{{ form_start(form, {attr: {id: form_id|default('mail-account-form'), class: 'form', 'data-controller': 'mail-provider'}}) }}
    {{ form_errors(form) }}

    {% if oauth_providers is defined and oauth_providers|length > 0 %}
        {#
            Camino corto: el proveedor devuelve el permiso y la aplicación ya
            sabe la dirección, el servidor y el método de autenticación. Es la
            única forma de conectar una cuenta de Microsoft, que ya no acepta
            contraseñas (D-93).
        #}
        <div class="card mb-4">
            <div class="card-header">
                <h2 class="card-title">Conectar con el proveedor</h2>
            </div>
            <div class="card-body">
                <p class="form-text">
                    Autoriza el acceso desde la página del proveedor: no hace falta buscar
                    el servidor ni generar ninguna contraseña.
                </p>
                <div class="d-flex flex-wrap gap-2">
                    {% for oauth_provider in oauth_providers %}
                        <a class="button button--ghost"
                           href="{{ path('app_mail_accounts_connect', {provider: oauth_provider.oauthKey()}) }}">
                            Conectar con {{ oauth_provider.label() }}
                        </a>
                    {% endfor %}
                </div>
            </div>
        </div>
    {% endif %}

    <div class="card mb-4">
        <div class="card-header">
            <h2 class="card-title">Qué buzón</h2>
        </div>
        <div class="card-body">
            <div class="row g-3">
                {{ form_row(form.provider) }}
                {{ form_row(form.emailAddress) }}
                {{ form_row(form.displayName) }}
            </div>
            <p class="form-text" data-mail-provider-target="appPassword" hidden>
                <a href="" target="_blank" rel="noopener noreferrer">Cómo generar la contraseña de aplicación</a>
                en la cuenta de tu proveedor.
            </p>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header">
            <h2 class="card-title">Cómo se conecta</h2>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-12" data-mail-provider-target="manual">
                    {{ form_row(form.imapHost) }}
                    {{ form_widget(form.discover) }}
                </div>
                <div class="col-12" data-mail-provider-target="manual">
                    <div class="row g-3">
                        {{ form_row(form.imapPort) }}
                        {{ form_row(form.imapEncryption) }}
                    </div>
                </div>
                {{ form_row(form.imapUsername) }}
                {{ form_row(form.password) }}
                {{ form_row(form.imapFolder) }}
            </div>
            <p class="form-text">
                La contraseña se guarda cifrada y solo se usa para leer. Nunca escribimos,
                movemos ni borramos nada de tu buzón.
            </p>
        </div>
    </div>

{{ form_end(form) }}
