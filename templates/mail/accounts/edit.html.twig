{% extends 'backoffice/base.html.twig' %}

{% block title %}Editar buzón — Suscripta{% endblock %}

{% block content %}
    <div class="bo-page-header">
        <div class="bo-page-header__heading">
            <h1 class="bo-page-header__title">Editar buzón</h1>
            <p class="bo-page-header__subtitle">
                Cambia el servidor, la carpeta o la contraseña. Deja la contraseña en blanco
                para conservar la actual.
            </p>
        </div>
    </div>

    {% include 'mail/accounts/_form.html.twig' with {
        form: form,
        form_id: 'mail-account-form',
        app_password_url: app_password_url,
    } only %}
{% endblock %}

{% block page_actions %}
    {{ include('backoffice/_form_actions.html.twig', {
        form_id: 'mail-account-form',
        submit_label: 'Guardar cambios',
        back_path: path('app_mail_accounts_show', {id: account.id.toRfc4122()}),
    }) }}
{% endblock %}
