{% extends 'base.html.twig' %}

{% block body %}
    <div class="app-shell" data-controller="sidebar">
        <header class="topbar">
            <button type="button"
                    class="topbar__toggle"
                    data-sidebar-target="toggle"
                    data-action="sidebar#toggle"
                    aria-controls="app-sidebar"
                    aria-expanded="false"
                    aria-label="Mostrar u ocultar el menú">
                <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                    <path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" fill="none"/>
                </svg>
            </button>

            <a class="topbar__brand" href="{{ path('app_dashboard') }}">
                <span aria-hidden="true">Suscripta</span>
                <span class="visually-hidden">Suscripta — inicio</span>
            </a>

            <span class="topbar__spacer"></span>

            {% block topbar_actions %}{% endblock %}

            {% if app.user %}
                {% set organizations = user_organizations() %}
                {% if organizations|length > 1 %}
                    <form method="post" action="{{ path('app_organization_switch') }}" class="topbar__org">
                        <input type="hidden" name="_token" value="{{ csrf_token('switch_organization') }}">
                        <label class="visually-hidden" for="active-organization">Organización activa</label>
                        <select class="select select--sm" id="active-organization" name="organization"
                                data-controller="auto-submit" data-action="change->auto-submit#submit">
                            {% for entry in organizations %}
                                <option value="{{ entry.organization.id }}"
                                        {% if is_active_organization(entry.organization) %}selected{% endif %}>
                                    {{ entry.organization.name }}
                                </option>
                            {% endfor %}
                        </select>
                        <noscript>
                            <button type="submit" class="btn btn--ghost btn--sm">Cambiar</button>
                        </noscript>
                    </form>
                {% endif %}

                <a class="btn btn--ghost btn--sm topbar__user" href="{{ path('app_settings_profile') }}"
                   title="{{ app.user.displayName }}">{{ app.user.displayName }}</a>

                <form method="post" action="{{ path('app_logout') }}">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                    <button type="submit" class="btn btn--ghost btn--sm">Salir</button>
                </form>
            {% endif %}
        </header>

        <div class="app-shell__body">
            <nav id="app-sidebar" class="sidebar" data-sidebar-target="panel" aria-label="Navegación principal">
                {% include 'layout/_nav.html.twig' %}
            </nav>

            <main id="main" class="app-main">
                <div class="container">
                    {% include 'layout/_flashes.html.twig' %}

                    {% if app.user and not app.user.verified and app.request.attributes.get('_route') != 'app_settings_profile' %}
                        <div class="alert alert--warning" role="status">
                            <p class="mb-2">
                                <strong>Confirma tu correo para conectar tu buzón.</strong>
                                Hemos enviado un enlace a {{ app.user.email }}.
                            </p>
                            <form method="post" action="{{ path('app_verify_email_resend') }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('resend_verification') }}">
                                <button type="submit" class="btn btn--secondary btn--sm">Reenviar el correo</button>
                            </form>
                        </div>
                    {% endif %}

                    {% block main %}{% endblock %}
                </div>
            </main>
        </div>
    </div>
{% endblock %}
