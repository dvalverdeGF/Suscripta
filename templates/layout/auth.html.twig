{#
    Layout de las pantallas públicas (login, registro, recuperación de contraseña).

    Comparte la paleta con el backoffice pero no su estructura: aquí no hay
    navegación, porque quien llega a estas pantallas todavía no ha entrado. El
    fondo oscuro con la tarjeta de papel cálido es el mismo del login del
    backoffice, de modo que la marca se lee igual antes y después de iniciar
    sesión.
#}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title>{% block title %}Suscripta{% endblock %}</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='6' fill='%230b1620'/><path d='M9 22V10h7a4 4 0 0 1 0 8h-3l6 4h-4l-6-4z' fill='%234cc9d4'/></svg>">
    {% block stylesheets %}
        <link rel="stylesheet" href="{{ asset('vendor/fontawesome/css/all.min.css') }}">
        <link rel="stylesheet" href="{{ asset('styles/backoffice.css') }}">
    {% endblock %}
    {% block javascripts %}{% endblock %}
</head>
<body>
    <main class="bo-login">
        <div class="bo-login__card">
            <div class="bo-login__header">
                {% block header %}
                    <h1 class="bo-login__title">{% block heading %}{% endblock %}</h1>
                    {% block subtitle %}{% endblock %}
                {% endblock %}
            </div>

            {% block flashes %}
                {% include 'backoffice/_flashes.html.twig' %}
            {% endblock %}

            {% block content %}{% endblock %}
        </div>
    </main>
</body>
</html>
