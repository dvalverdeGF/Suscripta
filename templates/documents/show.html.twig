{% extends 'backoffice/base.html.twig' %}

{% block title %}{{ document.displayName() }} — Suscripta{% endblock %}

{% block content %}
    <div class="bo-page-header">
        <div class="bo-page-header__heading">
            <p class="bo-page-header__back">
                <a href="{{ path('app_documents_index') }}">← Documentos</a>
            </p>
            <h1 class="bo-page-header__title">{{ document.displayName() }}</h1>
            <p class="bo-page-header__subtitle">
                <span class="badge text-bg-info">{{ document.type.label() }}</span>
                <span class="badge">{{ document.source.label() }}</span>
            </p>
        </div>
        <div class="bo-page-header__actions">
            <a class="btn btn-primary" href="{{ path('app_documents_download', {id: document.id.toRfc4122()}) }}">Descargar</a>
        </div>
    </div>

    <div class="row g-3">
        <div class="card">
            <div class="card-header">
                <h2 class="card-title">Ficha</h2>
            </div>
            <div class="card-body">
                <dl class="bo-definition-list">
                    <dt>Nombre original</dt>
                    <dd>{{ document.originalFilename }}</dd>

                    <dt>Tipo de fichero</dt>
                    <dd>{{ document.mimeType }}</dd>

                    <dt>Tamaño</dt>
                    <dd class="text-end">{{ document.humanSize() }}</dd>

                    <dt>Huella</dt>
                    <dd class="small text-secondary">{{ document.checksumSha256 }}</dd>

                    <dt>Añadido</dt>
                    <dd><time datetime="{{ document.createdAt|date('c') }}">{{ document.createdAt|date('d/m/Y H:i') }}</time></dd>

                    {% if document.deletedAt %}
                        <dt>Eliminado</dt>
                        <dd><time datetime="{{ document.deletedAt|date('c') }}">{{ document.deletedAt|date('d/m/Y H:i') }}</time></dd>
                    {% endif %}
                </dl>
            </div>
        </div>

        <div class="d-flex flex-column gap-3">
            <div class="card">
                <div class="card-header">
                    <h2 class="card-title">Servicio</h2>
                </div>
                <div class="card-body">
                    {% if service %}
                        <p>
                            <a href="{{ path('app_services_show', {id: service.id.toRfc4122()}) }}">{{ service.name }}</a>
                        </p>
                    {% else %}
                        <p class="text-muted">Este documento todavía no está asignado a ningún servicio.</p>
                    {% endif %}

                    <form method="post" action="{{ path('app_documents_attach', {id: document.id.toRfc4122()}) }}" class="form">
                        <input type="hidden" name="_token" value="{{ csrf_token('document_attach_' ~ document.id.toRfc4122()) }}">
                        <div class="mb-3">
                            <label class="form-label" for="document-service">Asignar a</label>
                            <select class="form-select" id="document-service" name="serviceId">
                                <option value="">Sin asignar</option>
                                {% for label, id in serviceChoices %}
                                    <option value="{{ id.toRfc4122() }}"
                                            {% if document.serviceId and document.serviceId.toRfc4122() == id.toRfc4122() %}selected{% endif %}>
                                        {{ label }}
                                    </option>
                                {% endfor %}
                            </select>
                        </div>
                        <button type="submit" class="btn btn-outline-secondary btn-sm">Guardar asignación</button>
                    </form>
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    <h2 class="card-title">Eliminar</h2>
                </div>
                <div class="card-body">
                    <p class="text-muted small">
                        El documento dejará de aparecer. El fichero se borra definitivamente
                        cuando caduque el periodo de retención.
                    </p>
                    <form method="post" action="{{ path('app_documents_delete', {id: document.id.toRfc4122()}) }}"
                          data-controller="confirm"
                          data-confirm-message-value="¿Seguro que quieres eliminar «{{ document.displayName() }}»?">
                        <input type="hidden" name="_token" value="{{ csrf_token('document_delete_' ~ document.id.toRfc4122()) }}">
                        <button type="submit" class="btn btn-danger btn-sm">Eliminar documento</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
