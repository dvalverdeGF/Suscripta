{% extends 'backoffice/base.html.twig' %}

{% block title %}Propuestas — Suscripta{% endblock %}

{% block content %}
    <div class="bo-page-header">
        <div class="bo-page-header__heading">
            <h1 class="bo-page-header__title">Propuestas</h1>
            <p class="bo-page-header__subtitle">
                {% if scope == 'suggestions' %}
                    Sospechas que Suscripta ha deducido de tu inventario. Son sugerencias, no hechos: revísalas y decide.
                {% elseif scope == 'facts' %}
                    Lo que Suscripta ha encontrado en tu correo y que espera tu confirmación.
                {% else %}
                    Lo que Suscripta ha encontrado en tu correo, y lo que ha deducido de tu inventario.
                {% endif %}
            </p>
        </div>
    </div>

    <nav class="d-flex flex-wrap align-items-center gap-2 mb-3" aria-label="Filtrar propuestas">
        {% set tabs = {
            'pending': 'Pendientes',
            'confirmed': 'Confirmadas',
            'ignored': 'Descartadas',
            'expired': 'Caducadas'
        } %}
        {% for value, label in tabs %}
            <a class="btn btn-sm {{ status.value == value ? 'btn-primary' : 'btn-outline-secondary' }}"
               href="{{ path('app_discoveries_index', {status: value, type: type ? type.value : null, scope: scope != 'all' ? scope : null}) }}"
               {% if status.value == value %}aria-current="page"{% endif %}>
                {{ label }}
                {% if counts[value] is defined %}<span class="small text-secondary">({{ counts[value] }})</span>{% endif %}
            </a>
        {% endfor %}
    </nav>

    {#
        Dos filtros más: por tipo de propuesta y por familia. La familia
        separa los **hechos** (lo que el sistema ha leído en un documento) de
        las **sugerencias** (lo que ha deducido del inventario). Mezclarlos es
        justo lo que el usuario quiere evitar, así que se pueden apartar con
        un clic (D-59).
    #}
    <nav class="d-flex flex-wrap align-items-center gap-2 mb-4" aria-label="Filtrar por tipo de propuesta">
        <span class="small text-muted">Familia:</span>
        {% for value, label in {'all': 'Todas', 'facts': 'Hechos', 'suggestions': 'Sugerencias'} %}
            <a class="btn btn-sm {{ scope == value ? 'btn-primary' : 'btn-outline-secondary' }}"
               href="{{ path('app_discoveries_index', {status: status.value, scope: value == 'all' ? null : value, type: type ? type.value : null}) }}"
               {% if scope == value %}aria-current="page"{% endif %}>
                {{ label }}
            </a>
        {% endfor %}

        <span class="small text-muted ms-2">Tipo:</span>
        <a class="btn btn-sm {{ type is null ? 'btn-primary' : 'btn-outline-secondary' }}"
           href="{{ path('app_discoveries_index', {status: status.value, scope: scope != 'all' ? scope : null}) }}"
           {% if type is null %}aria-current="page"{% endif %}>
            Todos
        </a>
        {% for candidate in types %}
            <a class="btn btn-sm {{ type and type.value == candidate.value ? 'btn-primary' : 'btn-outline-secondary' }}"
               href="{{ path('app_discoveries_index', {status: status.value, scope: scope != 'all' ? scope : null, type: candidate.value}) }}"
               {% if type and type.value == candidate.value %}aria-current="page"{% endif %}>
                {{ candidate.label() }}
            </a>
        {% endfor %}
    </nav>

    {% if discoveries is empty %}
        <div class="card">
            <div class="card-body">
                <div class="bo-empty">
                    <p class="bo-empty__title">
                        {% if status.value == 'pending' %}
                            No hay nada pendiente de revisar
                        {% else %}
                            No hay propuestas en este estado
                        {% endif %}
                    </p>
                    <p class="bo-empty__text">
                        {% if status.value == 'pending' and scope == 'suggestions' %}
                            No hay sospechas pendientes. Cuando el barrido detecte un posible duplicado,
                            un cobro que no ha llegado o un servicio sin actividad, aparecerá aquí.
                        {% elseif status.value == 'pending' %}
                            Cuando Suscripta encuentre una factura o un aviso de renovación en tu correo,
                            aparecerá aquí para que decidas si quieres seguirla.
                        {% else %}
                            Prueba con otro filtro.
                        {% endif %}
                    </p>
                    {% if status.value == 'pending' %}
                        <div class="d-flex flex-wrap align-items-center justify-content-end gap-2">
                            <a class="btn btn-primary" href="{{ path('app_mail_accounts_index') }}">Revisar buzones</a>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    {% else %}
        {#
            La bandeja de pendientes se envuelve en un formulario de lote: marcar
            varias propuestas y decidir de una vez es la forma más rápida de
            vaciarla. El lote confirma **exactamente** lo que propuso el
            pipeline; para corregir datos hay que abrir la propuesta.

            El formulario solo envuelve la tabla de pendientes: en las demás
            pestañas no hay nada que decidir en lote.
        #}
        {% set is_pending = status.value == 'pending' %}

        <form method="post"
              action="{{ path('app_discoveries_batch') }}"
              {% if is_pending %}data-controller="batch-select"{% endif %}>
            <input type="hidden" name="_token" value="{{ csrf_token('discovery_batch') }}">

            <div class="table-responsive">
                <table class="table bo-table bo-table--stack align-middle">
                    <caption class="visually-hidden">Propuestas de servicios detectados en el correo</caption>
                    <thead>
                        <tr>
                            {% if is_pending %}
                                <th scope="col" class="bo-table__select">
                                    <input type="checkbox"
                                           class="form-check-input"
                                           data-batch-select-target="toggle"
                                           aria-label="Seleccionar todas las propuestas">
                                </th>
                            {% endif %}
                            <th scope="col">Servicio</th>
                            <th scope="col">Tipo</th>
                            <th scope="col">Importe</th>
                            <th scope="col">Confianza</th>
                            <th scope="col">Detectado</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for discovery in discoveries %}
                            {% set proposed = discovery.proposedData %}
                            {% set source = sources[discovery.id.toRfc4122()]|default(null) %}
                            <tr>
                                {% if is_pending %}
                                    <td class="bo-table__select">
                                        <input type="checkbox"
                                               class="form-check-input"
                                               name="discoveries[]"
                                               value="{{ discovery.id.toRfc4122() }}"
                                               data-batch-select-target="checkbox"
                                               aria-label="Seleccionar la propuesta de {{ proposed.providerName|default('proveedor sin identificar') }}">
                                    </td>
                                {% endif %}
                                <td data-label="Servicio">
                                    <a href="{{ path('app_discoveries_show', {id: discovery.id.toRfc4122()}) }}">
                                        {{ proposed.providerName|default(proposed.serviceName|default('Proveedor sin identificar')) }}
                                    </a>
                                    {% if source and source.subject %}
                                        <span class="text-muted small">· {{ source.subject|slice(0, 60) }}</span>
                                    {% endif %}
                                </td>
                                <td data-label="Tipo">
                                    <span class="badge text-bg-{{ discovery.type.value == 'new_service' ? 'info' : 'warning' }}">
                                        {{ discovery.type.label() }}
                                    </span>
                                    {% if discovery.inference %}
                                        <span class="badge text-bg-secondary" title="Deducido del inventario, no leído en un documento">
                                            Sugerencia
                                        </span>
                                    {% endif %}
                                </td>
                                <td data-label="Importe" class="text-end">
                                    {% if proposed.amountMinor is defined and proposed.amountMinor is not null %}
                                        {{ (proposed.amountMinor / 100)|number_format(2, ',', '.') }} {{ proposed.currency|default('EUR') }}
                                        {% if proposed.billingPeriod is defined and proposed.billingPeriod %}
                                            <span class="text-muted small">/ {{ proposed.billingPeriod }}</span>
                                        {% endif %}
                                    {% else %}
                                        <span class="text-secondary">—</span>
                                    {% endif %}
                                </td>
                                <td data-label="Confianza">
                                    <span class="badge text-bg-{{ discovery.confidence.value == 'high' ? 'success' : (discovery.confidence.value == 'medium' ? 'warning' : 'danger') }}">
                                        {{ discovery.confidence.label() }}
                                    </span>
                                    <span class="text-muted small">{{ discovery.confidenceScore }} %</span>
                                </td>
                                <td data-label="Detectado">
                                    <time datetime="{{ discovery.detectedAt|date('c') }}">{{ discovery.detectedAt|date('d/m/Y') }}</time>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            {% if is_pending %}
                <div class="bo-batch-toolbar" data-batch-select-target="toolbar">
                    <span class="bo-batch-toolbar__count" data-batch-select-target="counter" aria-live="polite">
                        0 propuestas seleccionadas
                    </span>
                    <div class="bo-batch-toolbar__actions">
                        <button type="submit" name="action" value="confirm" class="btn btn-sm btn-primary">
                            Confirmar seleccionadas
                        </button>
                        <button type="submit" name="action" value="dismiss" class="btn btn-sm btn-outline-secondary">
                            Descartar seleccionadas
                        </button>
                    </div>
                </div>
            {% endif %}
        </form>
    {% endif %}
{% endblock %}
