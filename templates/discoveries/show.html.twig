{% extends 'backoffice/base.html.twig' %}

{% block title %}Propuesta: {{ discovery.proposedData.providerName|default('servicio sin identificar') }} — Suscripta{% endblock %}

{#
    Confirmar y descartar son decisiones opuestas sobre el mismo objeto, asi que
    comparten la barra de acciones del pie: separadas, cada una con su boton,
    para que la accion principal (confirmar) no compita visualmente con la
    irreversible (descartar), que queda a la derecha y separada.
#}
{% block page_actions %}
    {% if discovery.status.value == 'pending' %}
        <div class="bo-actions">
            <a class="btn btn-outline-secondary" href="{{ path('app_discoveries_index') }}">
                <i class="fa-solid fa-arrow-left me-1" aria-hidden="true"></i> Volver
            </a>
            <button class="btn btn-primary" type="submit" form="discovery-form">
                <i class="fa-solid fa-check me-1" aria-hidden="true"></i> Confirmar y añadir a mis servicios
            </button>
        </div>
    {% endif %}
{% endblock %}

{% block content %}
    <div class="bo-page-header">
        <div class="bo-page-header__heading">
            <h1 class="bo-page-header__title">{{ discovery.proposedData.providerName|default(discovery.proposedData.serviceName|default('Servicio sin identificar')) }}</h1>
            <p class="bo-page-header__subtitle">
                {{ discovery.type.label() }} detectado el {{ discovery.detectedAt|date('d/m/Y') }}
            </p>
        </div>
        <div class="bo-page-header__actions">
            <span class="badge text-bg-{{ discovery.confidence.value == 'high' ? 'success' : (discovery.confidence.value == 'medium' ? 'warning' : 'danger') }}">
                Confianza {{ discovery.confidence.label()|lower }} · {{ discovery.confidenceScore }} %
            </span>
            {% if discovery.aiUsed %}
                <span class="badge text-bg-info">Analizado con IA</span>
            {% else %}
                <span class="badge text-bg-success">Sin IA</span>
            {% endif %}
        </div>
    </div>

    {% if discovery.status.value != 'pending' %}
        <div class="alert alert-info mb-4">
            <p class="m-0">
                Esta propuesta ya está <strong>{{ discovery.status.label()|lower }}</strong>
                {% if discovery.reviewedAt %} desde el {{ discovery.reviewedAt|date('d/m/Y') }}{% endif %}.
                {% if discovery.resultingServiceId %}
                    <a href="{{ path('app_services_show', {id: discovery.resultingServiceId.toRfc4122()}) }}">Ver el servicio</a>.
                {% endif %}
            </p>
        </div>
    {% endif %}

    <div class="row g-3 mb-4">
        <div class="card">
            <div class="card-header">
                <h2 class="card-title">Por qué te lo proponemos</h2>
            </div>
            <div class="card-body">
                <p class="small text-muted">
                    Puntuación de emparejamiento: <strong>{{ discovery.matchScore }}</strong> / 100
                </p>
                {% if discovery.matchReasons is empty %}
                    <p class="text-secondary">No hay coincidencias con los servicios que ya tienes registrados.</p>
                {% else %}
                    <ul class="d-flex flex-column gap-2">
                        {% for reason in discovery.matchReasons %}
                            <li>
                                <span class="badge text-bg-{{ reason.weight > 0 ? 'success' : 'danger' }}">{{ reason.weight > 0 ? '+' : '' }}{{ reason.weight }}</span>
                                {{ reason.signal }}
                                {% if reason.detail is defined and reason.detail %}
                                    <span class="text-muted small">· {{ reason.detail }}</span>
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h2 class="card-title">De dónde sale</h2>
            </div>
            <div class="card-body">
                {% if source %}
                    <dl class="bo-definition-list">
                        <dt>Remitente</dt>
                        <dd>{{ source.fromName|default(source.fromAddress) }}</dd>
                        <dt>Asunto</dt>
                        <dd>{{ source.subject|default('—') }}</dd>
                        <dt>Recibido</dt>
                        <dd>{% if source.receivedAt %}{{ source.receivedAt|date('d/m/Y H:i') }}{% else %}—{% endif %}</dd>
                        <dt>Adjuntos</dt>
                        <dd>
                            {% if source.attachmentNames is empty %}
                                <span class="text-secondary">Ninguno</span>
                            {% else %}
                                {{ source.attachmentNames|join(', ') }}
                            {% endif %}
                        </dd>
                    </dl>
                    {% if source.bodyExcerpt %}
                        <p class="small text-muted mt-3">Extracto del mensaje:</p>
                        <blockquote class="small">{{ source.bodyExcerpt }}</blockquote>
                    {% endif %}
                {% else %}
                    <p class="text-secondary">El correo original ya no está disponible.</p>
                {% endif %}

                {% if evidence|length > 1 %}
                    <p class="small text-muted mt-3">
                        {{ evidence|length }} correos distintos sostienen esta propuesta.
                    </p>
                {% endif %}
            </div>
        </div>
    </div>

    {% if matchedService %}
        <div class="alert alert-warning mb-4">
            <p class="m-0">
                Coincide con <strong>{{ matchedService.name }}</strong>, que ya tienes registrado.
                Si confirmas, se actualizará su precio sin perder el historial anterior.
            </p>
        </div>
    {% endif %}

    {% if discovery.status.value == 'pending' %}
        {{ form_start(form, {action: path('app_discoveries_confirm', {id: discovery.id.toRfc4122()}), attr: {id: 'discovery-form', class: 'form'}}) }}
            {{ form_errors(form) }}

            <div class="card mb-4">
                <div class="card-header">
                    <h2 class="card-title">Revisa y confirma</h2>
                </div>
                <div class="card-body">
                    <p class="small text-muted">
                        Esto es lo que Suscripta ha deducido del correo. Corrige lo que haga falta:
                        lo que se guarde será lo que tú decidas, no lo que el sistema haya adivinado.
                    </p>
                    <div class="row g-3">
                        {{ form_row(form.name) }}
                        {{ form_row(form.providerId) }}
                        {{ form_row(form.categoryId) }}
                        {{ form_row(form.planName) }}
                        {{ form_row(form.amount) }}
                        {{ form_row(form.currency) }}
                        {{ form_row(form.billingPeriod) }}
                        {{ form_row(form.billingIntervalCount) }}
                        {{ form_row(form.startedAt) }}
                        {{ form_row(form.nextChargeAt) }}
                        {{ form_row(form.renewalAt) }}
                        {{ form_row(form.noticePeriodDays) }}
                    </div>
                    {{ form_row(form.autoRenews) }}
                    {{ form_row(form.notes) }}
                </div>
            </div>

        {{ form_end(form) }}

        <div class="card mt-4">
            <div class="card-body">
                <form method="post" action="{{ path('app_discoveries_dismiss', {id: discovery.id.toRfc4122()}) }}"
                      data-controller="confirm"
                      data-confirm-message-value="¿Descartar esta propuesta? El sistema dejará de proponerla.">
                    <input type="hidden" name="_token" value="{{ csrf_token('discovery_dismiss_' ~ discovery.id.toRfc4122()) }}">
                    <div class="mb-3">
                        <label class="form-label" for="dismiss-reason">Motivo (opcional)</label>
                        <input class="form-control" type="text" id="dismiss-reason" name="reason" maxlength="255"
                               placeholder="No es mío, ya no lo uso, es un error…">
                        <p class="form-text">Nos ayuda a no volver a proponerte lo mismo.</p>
                    </div>
                    <button type="submit" class="btn btn-danger">Descartar propuesta</button>
                </form>
            </div>
        </div>
    {% endif %}
{% endblock %}
