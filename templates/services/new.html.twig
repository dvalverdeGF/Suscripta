{% extends 'backoffice/base.html.twig' %}

{% block title %}Nuevo servicio — Suscripta{% endblock %}

{% block content %}
    <div class="bo-page-header">
        <div class="bo-page-header__heading">
            <h1 class="bo-page-header__title">Nuevo servicio</h1>
            <p class="bo-page-header__subtitle">Añade un servicio que pagas de forma recurrente.</p>
        </div>
    </div>

    {% include 'services/_form.html.twig' with {
        form: form,
        form_id: 'service-form',
    } only %}
{% endblock %}

{% block page_actions %}
    {{ include('backoffice/_form_actions.html.twig', {
        form_id: 'service-form',
        submit_label: 'Añadir servicio',
        submit_icon: 'fa-plus',
        back_path: path('app_services_index'),
    }) }}
{% endblock %}
