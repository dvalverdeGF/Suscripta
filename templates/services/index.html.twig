{% extends 'layout/app.html.twig' %}

{% block title %}Servicios — Suscripta{% endblock %}

{% block topbar_actions %}
    <a class="btn btn--primary btn--sm" href="{{ path('app_services_new') }}">Añadir servicio</a>
{% endblock %}

{% block main %}
    <div class="page-header">
        <div class="page-header__title">
            <h1>Servicios</h1>
            <p class="page-header__subtitle">Todo lo que pagas de forma recurrente, con su coste real.</p>
        </div>
    </div>

    {% if monthlyTotals is not empty %}
        <div class="grid grid--2 mb-6">
            {% for code, total in monthlyTotals %}
                <div class="stat">
                    <span class="stat__label">Coste mensual equivalente{% if monthlyTotals|length > 1 %} ({{ code }}){% endif %}</span>
                    <span class="stat__value">{{ total.format() }}</span>
                    {% if annualTotals[code] is defined %}
                        <span class="stat__hint">{{ annualTotals[code].format() }} al año</span>
                    {% endif %}
                </div>
            {% endfor %}
        </div>
    {% endif %}

    <form class="card mb-6" method="get" action="{{ path('app_services_index') }}">
        <div class="card__body">
            <div class="grid grid--2">
                <div class="field">
                    <label class="field__label" for="filter-q">Buscar</label>
                    <input class="input" type="search" id="filter-q" name="q" value="{{ filters.search }}" placeholder="Nombre o plan">
                </div>
                <div class="field">
                    <label class="field__label" for="filter-status">Estado</label>
                    <select class="select" id="filter-status" name="status">
                        <option value="">Todos</option>
                        {% for status in statuses %}
                            <option value="{{ status.value }}" {% if filters.status == status %}selected{% endif %}>{{ status.label() }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="field">
                    <label class="field__label" for="filter-category">Categoría</label>
                    <select class="select" id="filter-category" name="category">
                        <option value="">Todas</option>
                        {% for id, category in categories %}
                            <option value="{{ id }}" {% if filters.categoryId and filters.categoryId.toRfc4122() == id %}selected{% endif %}>{{ category.name }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="field">
                    <label class="field__label" for="filter-sort">Ordenar por</label>
                    <select class="select" id="filter-sort" name="sort">
                        <option value="name" {% if filters.sort == 'name' %}selected{% endif %}>Nombre</option>
                        <option value="next_charge" {% if filters.sort == 'next_charge' %}selected{% endif %}>Próximo cobro</option>
                        <option value="created" {% if filters.sort == 'created' %}selected{% endif %}>Más recientes</option>
                        <option value="updated" {% if filters.sort == 'updated' %}selected{% endif %}>Última modificación</option>
                    </select>
                </div>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn--secondary">Filtrar</button>
                <a class="btn btn--ghost" href="{{ path('app_services_index') }}">Limpiar</a>
            </div>
        </div>
    </form>

    {% if services is empty %}
        <div class="card">
            <div class="card__body">
                <div class="empty-state">
                    <p class="empty-state__title">Todavía no hay servicios</p>
                    <p class="empty-state__text">
                        Añádelos a mano o conecta tu correo de facturación para que Suscripta
                        los descubra por ti.
                    </p>
                    <div class="cluster cluster--end">
                        <a class="btn btn--primary" href="{{ path('app_services_new') }}">Añadir servicio</a>
                        {% if route_exists('app_mail_accounts_index') %}
                            <a class="btn btn--secondary" href="{{ path('app_mail_accounts_index') }}">Conectar correo</a>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    {% else %}
        <div class="table-wrapper">
            <table class="table table--responsive">
                <caption class="visually-hidden">Listado de servicios recurrentes</caption>
                <thead>
                    <tr>
                        <th scope="col">Servicio</th>
                        <th scope="col">Estado</th>
                        <th scope="col" class="num">Importe</th>
                        <th scope="col" class="num">Al mes</th>
                        <th scope="col">Próximo cobro</th>
                    </tr>
                </thead>
                <tbody>
                    {% for service in services %}
                        {% set price = service.currentPrice %}
                        <tr>
                            <td data-label="Servicio">
                                <a href="{{ path('app_services_show', {id: service.id.toRfc4122()}) }}">{{ service.name }}</a>
                                {% if service.planName %}
                                    <span class="text-muted text-sm">· {{ service.planName }}</span>
                                {% endif %}
                                {% if service.source.value == 'email_discovery' %}
                                    <span class="badge badge--info">Descubierto</span>
                                {% endif %}
                            </td>
                            <td data-label="Estado">
                                <span class="badge badge--{{ service.status.value == 'active' ? 'success' : (service.status.value == 'paused' ? 'warning' : 'danger') }}">
                                    {{ service.status.label() }}
                                </span>
                            </td>
                            <td data-label="Importe" class="num">
                                {% if price %}
                                    {{ price.amount.format() }}
                                    <span class="text-muted text-xs">{{ service.billingPeriod.label()|lower }}</span>
                                {% else %}
                                    <span class="text-subtle">—</span>
                                {% endif %}
                            </td>
                            <td data-label="Al mes" class="num">
                                {% set monthly = monthlyByService[service.id.toRfc4122()]|default(null) %}
                                {% if monthly %}{{ monthly.format() }}{% else %}<span class="text-subtle">—</span>{% endif %}
                            </td>
                            <td data-label="Próximo cobro">
                                {% if service.nextChargeAt %}
                                    <time datetime="{{ service.nextChargeAt|date('Y-m-d') }}">{{ service.nextChargeAt|date('d/m/Y') }}</time>
                                {% else %}
                                    <span class="text-subtle">—</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
{% endblock %}
