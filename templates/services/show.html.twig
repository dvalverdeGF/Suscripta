{% extends 'backoffice/base.html.twig' %}

{% block title %}{{ service.name }} — Suscripta{% endblock %}

{% block content %}
    <div class="bo-page-header">
        <div class="bo-page-header__heading">
            <h1 class="bo-page-header__title">{{ service.name }}</h1>
            <p class="bo-page-header__subtitle">
                {% if provider %}{{ provider.name }}{% else %}Sin proveedor{% endif %}
                {% if service.planName %} · {{ service.planName }}{% endif %}
                {% if category %} · {{ category.name }}{% endif %}
            </p>
            <div class="bo-page-header__meta">
                <span class="badge text-bg-{{ service.status.value == 'active' ? 'success' : (service.status.value == 'paused' ? 'warning' : 'danger') }}">
                    {{ service.status.label() }}
                </span>
                {% if service.source.value == 'email_discovery' %}
                    <span class="badge text-bg-info">Descubierto en tu correo</span>
                {% endif %}
            </div>
        </div>
        <div class="bo-page-header__actions">
            <a class="btn btn-outline-secondary" href="{{ path('app_services_edit', {id: service.id.toRfc4122()}) }}">
                <i class="fa-solid fa-pen-to-square me-1"></i> Editar
            </a>
        </div>
    </div>

    <div class="bo-metrics mb-4">
        <div class="bo-metric">
            <span class="bo-metric__label">Importe por cobro</span>
            <span class="bo-metric__value">
                {% if service.currentAmount %}{{ service.currentAmount.format() }}{% else %}—{% endif %}
            </span>
            <span class="bo-metric__hint">{{ service.billingPeriod.label()|lower }}{% if service.billingIntervalCount > 1 %} (cada {{ service.billingIntervalCount }}){% endif %}</span>
        </div>
        <div class="bo-metric">
            <span class="bo-metric__label">Equivalente mensual</span>
            <span class="bo-metric__value">{% if monthlyEquivalent %}{{ monthlyEquivalent.format() }}{% else %}—{% endif %}</span>
            <span class="bo-metric__hint">{% if annualCost %}{{ annualCost.format() }} al año{% endif %}</span>
        </div>
        <div class="bo-metric">
            <span class="bo-metric__label">Próximo cobro</span>
            <span class="bo-metric__value">
                {% if service.nextChargeAt %}{{ service.nextChargeAt|date('d/m/Y') }}{% else %}—{% endif %}
            </span>
            {% if service.nextChargeAt %}
                <span class="bo-metric__hint">{{ service.nextChargeAt|date('Y-m-d') }}</span>
            {% endif %}
        </div>
        <div class="bo-metric">
            <span class="bo-metric__label">Renovación</span>
            <span class="bo-metric__value">
                {% if service.renewalAt %}{{ service.renewalAt|date('d/m/Y') }}{% else %}—{% endif %}
            </span>
            <span class="bo-metric__hint">
                {% if service.autoRenews %}Se renueva automáticamente{% else %}No se renueva automáticamente{% endif %}
                {% if service.noticeDeadline %} · avisar antes del {{ service.noticeDeadline|date('d/m/Y') }}{% endif %}
            </span>
        </div>
    </div>

    {% if priceChangeRatio is not null %}
        <div class="alert alert-{{ priceChangeRatio > 0 ? 'warning' : 'info' }} mb-4">
            <p class="m-0">
                El precio vigente es un
                {{ (priceChangeRatio * 100)|abs|number_format(1, ',', '.') }} %
                {{ priceChangeRatio > 0 ? 'más alto' : 'más bajo' }}
                que el anterior.
            </p>
        </div>
    {% endif %}

    {% if totalVariation is not null and totalVariationRatio is not null %}
        <div class="card mb-4">
            <div class="card-header">
                <h2 class="card-title">Cuánto ha cambiado desde el principio</h2>
            </div>
            <div class="card-body">
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <span class="badge text-bg-{{ totalVariation.amountMinor > 0 ? 'danger' : 'success' }}">
                        {{ totalVariation.amountMinor > 0 ? '+' : '' }}{{ totalVariation.format() }}
                    </span>
                    <span class="badge text-bg-{{ totalVariation.amountMinor > 0 ? 'danger' : 'success' }}">
                        {{ totalVariationRatio > 0 ? '+' : '' }}{{ (totalVariationRatio * 100)|number_format(1, ',', '.') }} %
                    </span>
                    <span class="text-muted small">
                        desde el primer precio registrado, el
                        {{ priceHistory|first ? priceHistory|first.validFrom|date('d/m/Y') : '' }}
                    </span>
                </div>
            </div>
        </div>
    {% endif %}

    <div class="card mb-4">
        <div class="card-header">
            <h2 class="card-title">Historial de precios</h2>
        </div>
        <div class="card-body p-0">
            {% if service.prices is empty %}
                <div class="bo-empty">
                    <p class="bo-empty__text">Todavía no hay ningún precio registrado.</p>
                </div>
            {% else %}
                <div class="table-responsive">
                    <table class="table bo-table bo-table--stack align-middle">
                        <caption class="visually-hidden">Historial de precios del servicio</caption>
                        <thead>
                            <tr>
                                <th scope="col">Desde</th>
                                <th scope="col">Hasta</th>
                                <th scope="col" class="text-end">Importe</th>
                                <th scope="col" class="text-end">Variación</th>
                                <th scope="col">Origen</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for entry in priceHistory %}
                                <tr>
                                    <td data-label="Desde">{{ entry.validFrom|date('d/m/Y') }}</td>
                                    <td data-label="Hasta">
                                        {% if entry.validTo %}{{ entry.validTo|date('d/m/Y') }}{% else %}<span class="badge text-bg-success">Vigente</span>{% endif %}
                                    </td>
                                    <td data-label="Importe" class="text-end">{{ entry.amount.format() }}</td>
                                    <td data-label="Variación" class="text-end">
                                        {% if entry.hasVariation %}
                                            <span class="badge text-bg-{{ entry.isIncrease ? 'danger' : 'success' }}">
                                                {{ entry.isIncrease ? '+' : '' }}{{ entry.variationAbsolute.format() }}
                                                {% if entry.variationRatio is not null %}
                                                    ({{ entry.variationRatio > 0 ? '+' : '' }}{{ (entry.variationRatio * 100)|number_format(1, ',', '.') }} %)
                                                {% endif %}
                                            </span>
                                        {% else %}
                                            <span class="text-secondary">—</span>
                                        {% endif %}
                                    </td>
                                    <td data-label="Origen">
                                        {{ entry.source.label() }}
                                        {% if entry.note %}<span class="text-muted small">· {{ entry.note }}</span>{% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
        <div class="card-footer">
            <form class="form" method="post" action="{{ path('app_services_price', {id: service.id.toRfc4122()}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('service_price_' ~ service.id.toRfc4122()) }}">
                <div class="row g-3">
                    <div class="mb-3">
                        <label class="form-label" for="price-amount">Importe nuevo</label>
                        <input class="form-control" type="text" id="price-amount" name="amount" inputmode="decimal" placeholder="0,00" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="price-date">Vigente desde</label>
                        <input class="form-control" type="date" id="price-date" name="validFrom" value="{{ 'now'|date('Y-m-d') }}">
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="price-note">Motivo (opcional)</label>
                    <input class="form-control" type="text" id="price-note" name="note" maxlength="255" placeholder="Subida anual, cambio de plan…">
                </div>
                <div class="d-flex flex-wrap gap-2 mt-3">
                    <button type="submit" class="btn btn-outline-secondary">Cambiar precio</button>
                </div>
            </form>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header">
            <h2 class="card-title">Historial del servicio</h2>
        </div>
        <div class="card-body p-0">
            {% if service.events is empty %}
                <div class="bo-empty">
                    <p class="bo-empty__text">Sin cambios registrados.</p>
                </div>
            {% else %}
                <ul class="bo-timeline">
                    {% for event in service.events %}
                        <li class="bo-timeline__item">
                            <span class="bo-timeline__date">{{ event.occurredAt|date('d/m/Y') }}</span>
                            <span class="bo-timeline__label">{{ event.type.label() }}</span>
                            {% if event.data is not empty %}
                                <span class="text-muted small">
                                    {% for key, value in event.data %}
                                        {% if value is not null %}{{ key }}: {{ value }}{% if not loop.last %} · {% endif %}{% endif %}
                                    {% endfor %}
                                </span>
                            {% endif %}
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h2 class="card-title">Ciclo de vida</h2>
        </div>
        <div class="card-body">
            <div class="d-flex flex-wrap align-items-center gap-2">
                {% if service.status.value == 'active' %}
                    <form method="post" action="{{ path('app_services_pause', {id: service.id.toRfc4122()}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('service_lifecycle_' ~ service.id.toRfc4122()) }}">
                        <button type="submit" class="btn btn-outline-secondary">Pausar</button>
                    </form>
                {% else %}
                    <form method="post" action="{{ path('app_services_resume', {id: service.id.toRfc4122()}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('service_lifecycle_' ~ service.id.toRfc4122()) }}">
                        <button type="submit" class="btn btn-outline-secondary">Reactivar</button>
                    </form>
                {% endif %}

                {% if service.status.value != 'cancelled' %}
                    <form method="post" action="{{ path('app_services_cancel', {id: service.id.toRfc4122()}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('service_lifecycle_' ~ service.id.toRfc4122()) }}">
                        <button type="submit" class="btn btn-outline-secondary">Marcar como cancelado</button>
                    </form>
                {% endif %}
            </div>
            <p class="text-muted small mt-3">
                Cancelar conserva el historial de precios: podrás seguir consultando cuánto pagabas.
            </p>
        </div>
        <div class="card-footer">
            <form method="post" action="{{ path('app_services_delete', {id: service.id.toRfc4122()}) }}"
                  data-controller="confirm"
                  data-confirm-message-value="Se borrará el servicio y todo su historial de precios. Esta acción no se puede deshacer.">
                <input type="hidden" name="_token" value="{{ csrf_token('service_delete_' ~ service.id.toRfc4122()) }}">
                <button type="submit" class="btn btn-danger">Eliminar definitivamente</button>
            </form>
        </div>
    </div>
{% endblock %}
