{% extends 'backoffice/base.html.twig' %}

{% block title %}Editar {{ service.name }} — Suscripta{% endblock %}

{% block content %}
    <div class="bo-page-header">
        <div class="bo-page-header__heading">
            <h1 class="bo-page-header__title">Editar servicio</h1>
            <p class="bo-page-header__subtitle">{{ service.name }}</p>
        </div>
    </div>

    <div class="alert alert-info mb-4">
        <p class="m-0">
            El importe no se cambia desde aquí: un cambio de precio genera una fila nueva en el
            historial. Usa «Cambiar precio» en la ficha del servicio.
        </p>
    </div>

    {% include 'services/_form.html.twig' with {
        form: form,
        form_id: 'service-form',
    } only %}
{% endblock %}

{% block page_actions %}
    {{ include('backoffice/_form_actions.html.twig', {
        form_id: 'service-form',
        submit_label: 'Guardar cambios',
        back_path: path('app_services_show', {id: service.id.toRfc4122()}),
    }) }}
{% endblock %}
