{#
    El formulario lleva `id` porque el boton de guardar vive en la barra de
    acciones del pie y se le asocia con el atributo HTML `form`.
#}
{{ form_start(form, {attr: {id: form_id|default('service-form'), class: 'form'}}) }}
    {{ form_errors(form) }}

    <div class="card mb-4">
        <div class="card-header">
            <h2 class="card-title">Qué es</h2>
        </div>
        <div class="card-body">
            <div class="row g-3">
                {{ form_row(form.name) }}
                {{ form_row(form.providerId) }}
                {{ form_row(form.categoryId) }}
                {{ form_row(form.planName) }}
            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header">
            <h2 class="card-title">Cuánto cuesta</h2>
        </div>
        <div class="card-body">
            <div class="row g-3">
                {{ form_row(form.amount) }}
                {{ form_row(form.currency) }}
                {{ form_row(form.billingPeriod) }}
                {{ form_row(form.billingIntervalCount) }}
            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header">
            <h2 class="card-title">Cuándo se cobra y cuándo se renueva</h2>
        </div>
        <div class="card-body">
            <div class="row g-3">
                {{ form_row(form.startedAt) }}
                {{ form_row(form.nextChargeAt) }}
                {{ form_row(form.renewalAt) }}
                {{ form_row(form.noticePeriodDays) }}
                {{ form_row(form.commitmentEndAt) }}
                {{ form_row(form.paymentMethodLabel) }}
            </div>
            {{ form_row(form.autoRenews) }}
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            {{ form_row(form.notes) }}
        </div>
    </div>

{{ form_end(form) }}
